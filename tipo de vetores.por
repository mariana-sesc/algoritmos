programa {
  funcao inicio() {
    inteiro notas[5]   // vetor de 5 inteiros
    real alturas[10]   // vetor de 10 reais
    cadeia nomes[3]    //vetor de 3 cadeias
    logico respostas[4]  // vetor de 4 logicos

    // Atribuindo valores individualmente
    nomes[0] = "ana"
    nomes[1] = "bruno"
    nomes[2] = "carla"
    notas[0] = 9.00
    notas[1] = 10.00
    notas[2] = 6.00
    notas[3] = 5.00
    notas[4] = 8.00
    alturas[0] = 1.68
    alturas[1] = 1.60
    alturas[2] = 1.50
    alturas[3] = 1.67
    alturas[4] = 1.58
    alturas[5] = 1.79
    alturas[6] = 1.80
    alturas[7] = 1.63
    alturas[8] = 1.57
    alturas[9] = 1.87
    respostas[0] = verdadeiro
    respostas[1] = falso
    respostas[2] = verdadeiro
    respostas[3] = falso

    escreva(nomes[0])  // ana
     escreva(nomes[1]) // bruno
     escreva(nomes[2]) // carla
     
     escreva(notas[0]) // 9.00
     escreva(notas[1]) // 10.00
     escreva(notas[2]) // 6.00
     escreva(notas[3]) // 5.00
     escreva(notas[4]) // 8.00

    escreva(alturas[0]) // 1.68
    escreva(alturas[1]) // 1.60
    escreva(alturas[2]) // 1.50
    escreva(alturas[3]) // 1.67
    escreva(alturas[4]) // 1.58
    escreva(alturas[5]) // 1.79
    escreva(alturas[6]) // 1.80
    escreva(alturas[7]) // 1.63
    escreva(alturas[8]) // 1.57
    escreva(alturas[9]) // 1.87

    escreva(respostas[0]) // verdadeiro
    escreva(respostas[1]) // falso
    escreva(respostas[2]) // verdadeiro
    escreva(respostas[3]) // falso
     
       
  }
}
