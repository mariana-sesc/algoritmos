programa{
    funcao inicio () {
        inteiro numero

        escreva("De qual numero voce deseja ver a tabuada?)
        leia(numero)

        escreva("---tabuada do", numero, "---\n")

        //0 contador "i" começa em 1, vai ate 10 aumenta de 1 em 1 (1++)
        para(inteiro i=i; i ,= 10, i++) {
            inteiro resultado =numero*idadeescreva(numero, "x", i, "=", resultado, "\n")
        }
    }
}