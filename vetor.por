
programa {
  funcao inicio() {
    inteiro numeros[5]

    numeros[0] = 10 // primeira posição
    numeros[1] = 20 // segunda posição
    numeros[2] = 30 // terceira posição
    numeros[3] = 40 // quarta posição
    numeros[4] = 50 // quinta posição (ultima!)

    escreva(numeros[0]) // imprime 10
    escreva(numeros[1]) // imprime 20
    escreva(numeros[2]) // imprime 30
    escreva(numeros[3]) // imprime 40
    escreva(numeros[4]) // imprime 50
    
  }
}
