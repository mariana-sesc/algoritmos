programa {
  funcao inicio() {
    //Declaração de variável3
    cadeia nomeUsuario

    //ENTRADA: capturando dados do usuário
    escreva("Diga seu nome")
    leia( nomeUsuario)

    //SAÍDA: exibindo o resultado
    escreva("olá, ",nomeUsuario, "!" )
    
  }
}
